# =============================================================================
# THOFNAA INSTITUTE — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
#
# HOW TO USE THIS FILE
# --------------------
# 1. Copy this file:  cp .env.example .env.local
# 2. Fill in real values in .env.local
# 3. NEVER commit .env.local — it is blocked by .gitignore
# 4. For Vercel: paste each value into Project → Settings → Environment Variables
#
# VARIABLE PLACEMENT GUIDE
# ─────────────────────────────────────────────────────────────────────────────
# Variable                        | .env.local | Vercel Production | Vercel Preview
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL        |    YES     |       YES         |    YES
# NEXT_PUBLIC_SUPABASE_ANON_KEY   |    YES     |       YES         |    YES
# SUPABASE_SERVICE_ROLE_KEY       |    YES     |       YES         |    YES *
# RESEND_API_KEY                  |    YES     |       YES         |    YES *
# PAYMENT_FROM_EMAIL              |    YES     |       YES         |    YES
# ADMIN_EMAIL                     |    YES     |       YES         |    YES
# NEXT_PUBLIC_SITE_URL            |    YES     |       YES         |    YES **
#
# * Use a DIFFERENT restricted test key for Preview to avoid live email/data.
# ** Must be your live domain in Production (e.g. https://thofnaa.vercel.app)
#    and your preview URL in Preview (e.g. https://thofnaa-git-main-xxx.vercel.app)
# =============================================================================


# ─── 1. SUPABASE — PUBLIC (safe in browser bundle) ───────────────────────────
# Found in: Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Found in: Supabase Dashboard → Project Settings → API → anon / public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ─── 2. SUPABASE — SECRET (SERVER ONLY — never expose to browser) ─────────────
# ⚠ CRITICAL: This key bypasses Row Level Security. Keep it strictly private.
# Found in: Supabase Dashboard → Project Settings → API → service_role key
# Rule: NEVER prefix with NEXT_PUBLIC_ — that would expose it to every visitor.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ─── 3. RESEND EMAIL SERVICE — SECRET (SERVER ONLY) ──────────────────────────
# Found in: resend.com → Dashboard → API Keys
# Rule: Server-only. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address for payment confirmation emails.
# Must be a verified domain address in your Resend account.
# Format: "Display Name <email@yourdomain.com>"
PAYMENT_FROM_EMAIL=THOFNAA Institute <receipts@thofnaa.edu.lk>

# Administrator inbox for internal notifications.
ADMIN_EMAIL=tthofnaa@gmail.com


# ─── 4. SITE URL — PUBLIC ─────────────────────────────────────────────────────
# Used for generating absolute URLs in emails and canonical links.
# Local development:    http://localhost:3000
# Vercel Production:    https://thofnaa.vercel.app   (your actual domain)
# Vercel Preview:       https://thofnaa-git-branch-xxx.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

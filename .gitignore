# =============================================================================
# THOFNAA INSTITUTE — .gitignore
# =============================================================================

# ── Node Modules ─────────────────────────────────────────────────────────────
/node_modules
/.pnpm
/.yarn

# ── Next.js Build Output ──────────────────────────────────────────────────────
/.next/
/out/
/build

# ── Environment Files — ALL VARIANTS BLOCKED ─────────────────────────────────
# These files contain secrets and must NEVER be committed to version control.
.env
.env.*
!.env.example
# The above rules mean:
#   .env            → blocked
#   .env.local      → blocked
#   .env.production → blocked
#   .env.*.local    → blocked
#   .env.example    → ALLOWED (the public template)

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── System & Editor Files ─────────────────────────────────────────────────────
.DS_Store
*.pem
Thumbs.db

# ── Vercel ────────────────────────────────────────────────────────────────────
.vercel

# ── TypeScript Build Info ──────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Coverage ──────────────────────────────────────────────────────────────────
/coverage
